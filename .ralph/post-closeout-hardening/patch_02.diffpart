es() if line.startswith("- [ ]")]
+    require(not bare_unchecked, f"post-closeout TODO has unchecked required items: {bare_unchecked[:3]}")
+
+    for token in RUNTIME_COMMAND_TOKENS:
+        require(token in panel, f"session panel does not expose runtime control token {token!r}")
+    for helper in ("canPauseRuntime", "canResumeRuntime", "canRefreshRuntime", "runtimeStateLabel"):
+        require(helper in runtime_view, f"runtime-control view helper missing {helper}")
+        require(helper in runtime_view_test, f"runtime-control view helper lacks test coverage {helper}")
+
+    require(
+        "notifyShortcutOwnershipMayHaveChanged" in panel,
+        "session panel must notify the shortcut ownership refresh path after terminal sessions",
+    )
+    require(
+        'window.dispatchEvent(new Event("focus"))' in panel,
+        "shortcut ownership refresh must reuse the existing focus-time fail-closed lookup",
+    )
+    for event_name in ("session.exited", "session.crashed", "session.failed"):
+        require(event_name in panel, f"session panel must react to terminal lifecycle event {event_name}")
+
+    for field in SESSION_SNAPSHOT_FIELDS:
+        require(field in types, f"frontend SessionSnapshot is missing backend field {field!r}")
+
+    require("Windows" in spec and "per-user temporary-directory" in spec, "Windows bootstrap ACL contract must remain explicit in the spec")
+    require("NamedTempFile" in control, "bootstrap must remain tempfile-backed")
+    require("tempfile()" in control, "bootstrap must be created through tempfile rather than a predictable path")
+    require("Permissions::from_mode(0o600)" in control, "Unix bootstrap permissions must remain 0600")
+
+    require("assert_eq!(" in build_rs and "anchor drifted" in build_rs, "runtime-control composition must fail closed on anchor drift")
+    for fragment in RUNTIME_FRAGMENTS:
+        require(fragment in build_rs, f"runtime-control fragment is not tracked by build.rs: {fragment}")
+    require("runtime_control_mt710.lua" in build_rs, "generated runtime-control Lua output name must remain explicit")
+    require("runtime_control_mt710.rs" in build_rs, "generated runtime-control Rust output name must remain explicit")
+
+    require("test-post-closeout-hardening.py" in workflow, "Tauri project workflow must run the hardening regression")
+
+    print("Post-closeout hardening regression passed")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
