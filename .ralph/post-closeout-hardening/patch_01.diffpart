+#!/usr/bin/env python3
+"""Static regression checks for the post-closeout hardening batch."""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+REPO_ROOT = Path(__file__).resolve().parents[2]
+SPEC = REPO_ROOT / "docs/MAME_TAURI_POST_CLOSEOUT_HARDENING_SPEC_2026-09-13.md"
+TODO = REPO_ROOT / "docs/MAME_TAURI_POST_CLOSEOUT_HARDENING_TODO_2026-09-13.md"
+SESSION_PANEL = REPO_ROOT / "tauri/src/session/SessionControlPanel.tsx"
+RUNTIME_VIEW = REPO_ROOT / "tauri/src/session/runtimeControlView.ts"
+RUNTIME_VIEW_TEST = REPO_ROOT / "tauri/src/session/runtimeControlView.test.ts"
+TYPES = REPO_ROOT / "tauri/src/backend/types.ts"
+CONTROL = REPO_ROOT / "tauri/src-tauri/src/sessions/control.rs"
+BUILD_RS = REPO_ROOT / "tauri/src-tauri/build.rs"
+WORKFLOW = REPO_ROOT / ".github/workflows/tauri-project.yml"
+
+RUNTIME_COMMAND_TOKENS = (
+    "pauseMame",
+    "resumeMame",
+    "resetMame",
+    "setMameMute",
+    "queryMameRuntimeState",
+    "Refresh state",
+    "Soft reset",
+)
+SESSION_SNAPSHOT_FIELDS = (
+    "executable: MameExecutableIdentity",
+    "effectiveArgv: string[]",
+    "effectiveConfig: EffectiveLaunchConfig",
+    "createdAtEpochMs: number",
+    "startedAtEpochMs: number | null",
+    "endedAtEpochMs: number | null",
+    "exitCode: number | null",
+    "terminationSignal: number | null",
+    "forcedTermination: boolean",
+    "stdoutTail: string",
+    "stderrTail: string",
+    "stdoutTruncated: boolean",
+    "stderrTruncated: boolean",
+    "diagnosticError: string | null",
+)
+RUNTIME_FRAGMENTS = (
+    "src/sessions/control.rs",
+    "src/sessions/control_exit.rs",
+    "src/sessions/control_save_state.rs",
+    "src/sessions/control_load_state.rs",
+    "src/sessions/control_mute.rs",
+    "src/sessions/control_query_state.rs",
+    "src/sessions/control_pause_resume.lua",
+    "src/sessions/control_load_state.lua",
+    "src/sessions/control_mute.lua",
+    "src/sessions/control_query_state.lua",
+)
+
+
+def require(condition: bool, message: str) -> None:
+    if not condition:
+        raise AssertionError(message)
+
+
+def read(path: Path) -> str:
+    require(path.is_file(), f"missing required hardening file: {path.relative_to(REPO_ROOT)}")
+    return path.read_text(encoding="utf-8")
+
+
+def main() -> int:
+    spec = read(SPEC)
+    todo = read(TODO)
+    panel = read(SESSION_PANEL)
+    runtime_view = read(RUNTIME_VIEW)
+    runtime_view_test = read(RUNTIME_VIEW_TEST)
+    types = read(TYPES)
+    control = read(CONTROL)
+    build_rs = read(BUILD_RS)
+    workflow = read(WORKFLOW)
+
+    for task in ("PCH-001", "PCH-002", "PCH-003", "PCH-004", "PCH-005", "PCH-006", "PCH-007"):
+        require(task in spec, f"spec is missing {task}")
+        require(task in todo, f"TODO is missing {task}")
+    bare_unchecked = [line for line in todo.splitlin